# FnGuide Logotype — kerning (1000 UPM)
# 자동 생성: autokern.py → compute_kern.py → classify.py → write_fea.py
# 우선순위: 개별 쌍(로고 쌍·예외) > 클래스 쌍

languagesystem DFLT dflt;
languagesystem latn dflt;

# ---- 첫 글자 클래스 (오른쪽 면이 비슷한 글자) ----
@R_J = [J U];
@R_stem_UC = [H I M N];
@R_f = [f f_f];
@R_f_k = [f_k k];
@R_f_h = [f_h h];
@R_u = [u z];
@R_f_f_i = [f_f_i f_i];
@R_n = [n s];
@R_a = [a m];
@R_d = [d f_f_l f_l l];
@R_digits = [eight five four nine one seven six three two zero];
@R_dashes = [endash hyphen];
@R_quotes = [quotedbl quotedblleft quoteleft quotesingle];
@R_quotedblright = [quotedblright quoteright];
@R_symbols = [ampersand asciicircum asciitilde asterisk at backslash bar braceleft braceright bracketleft bracketright colon comma dollar equal exclam grave greater less numbersign parenleft parenright percent period plus question semicolon slash underscore];

# ---- 두 번째 글자 클래스 (왼쪽 면이 비슷한 글자) ----
@L_I = [I K];
@L_round_UC = [C G O];
@L_stem_UC = [B D E F H L M N P R];
@L_f = [f f_b f_f f_f_i f_f_l f_h f_i f_k f_l];
@L_m = [m n r];
@L_ascender_lc = [b h k l];
@L_digits = [eight five four nine one seven six three two zero];
@L_dashes = [endash hyphen];
@L_quotes_close = [quotedbl quotesingle];
@L_quotes_open = [quotedblleft quotedblright quoteleft quoteright];
@L_symbols = [ampersand asciicircum asciitilde asterisk at backslash bar braceleft braceright bracketleft bracketright colon dollar equal exclam grave greater less numbersign parenleft parenright percent plus question semicolon slash underscore];

