# ---- f 합자 (긴 조합 우선) ----
feature liga {
    sub f f i by f_f_i;
    sub f f l by f_f_l;
    sub f f by f_f;
    sub f i by f_i;
    sub f l by f_l;
    sub f b by f_b;
    sub f h by f_h;
    sub f k by f_k;
} liga;
